# Copy to `.env` and fill in. `.env` is gitignored — never commit your key.
#
#   cp .env.example .env

# Server password (shared by ircserv and the companion's IRC_PASS).
IRC_SERVER_PASSWORD=changeme

# Host port the server is published on (container port is always 6667).
IRC_PORT=6667

# Companion settings.
IRC_NICK=assistant
IRC_CHANNELS=#general

# Claude API — REQUIRED for the ai-assistant service.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5
# Thinking depth / spend: low | medium | high | xhigh | max.
# medium keeps chat latency reasonable; raise it for harder questions.
ANTHROPIC_EFFORT=medium

# ── Assistant behaviour ────────────────────────────────────────────────────
# Announce each tool call in-channel as a NOTICE ("· irc_channel_members #x").
AI_SHOW_TOOLS=true
# Let it search and fetch from the web (server-side tools).
AI_WEB_TOOLS=true
# Lines of channel scrollback it can read back per target.
AI_LOG_LINES=300
# Seconds a nick must wait between questions.
AI_COOLDOWN_SECS=5
# Let it JOIN/PART and post into other channels.
AI_ALLOW_CHANNEL_OPS=true
# Let it KICK / INVITE / set TOPIC / change MODE. OFF by default: an enabled
# bot acts on chat text. Requires BOTH an AI_ADMINS nick AND that nick being a
# live channel operator, verified per action.
AI_ALLOW_MODERATION=false
AI_ADMINS=

# ── Optional real-time/web tier (docker compose --profile platform up) ──
# Host port for realtime-agnostic (container always listens on 4000).
# Default 4455 avoids the common 4000 clash with other local stacks.
REALTIME_PORT=4455
RT_BRIDGE_NICK=rtbridge
RT_DEFAULT_CHANNEL=#general
RT_INBOUND_TOPICS=pg/**,mongo/**,irc-in/**
RUST_LOG=info
# Per-web-user puppet IRC nicks (each web user appears under its own nick).
RT_PUPPETS=true
RT_PUPPET_MAX=50
RT_PUPPET_TTL_SECS=120
