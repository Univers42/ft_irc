# Build artifacts — the build writes everything under build/ (objects, deps
# and binaries, server and test suite alike) and nothing into the repo root.
# The bare `ircserv` line only keeps a stale root symlink from an old checkout
# out of `git status`; nothing produces one any more (fclean removes it).
build/
ircserv

# Editor/OS noise
*.o
*.d
.DS_Store

# Docker / local secrets
.env

.claude/workflow/tasks/*
.claude/skills*
# Simulation harness state
.sim/

CLAUDE/*

# Python bytecode from the grammar test tooling
__pycache__/
*.pyc

# A nested clone of the 42 evals site (53 MB of images/JS, its own .git).
# Working material, not part of ft_irc.
evals42/
