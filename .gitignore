# Build artifacts — the build writes everything under build/ (objects, deps
# and binaries, server and test suite alike); ./ircserv is the root symlink
# onto build/bin/ircserv that the subject's run line needs.
build/
ircserv

# Editor/OS noise
*.o
*.d
.DS_Store

# Docker / local secrets
.env

.claude/workflow/tasks/*
.claude/skills*
# Simulation harness state
.sim/

CLAUDE/*

# Python bytecode from the grammar test tooling
__pycache__/
*.pyc

# A nested clone of the 42 evals site (53 MB of images/JS, its own .git).
# Working material, not part of ft_irc.
evals42/
